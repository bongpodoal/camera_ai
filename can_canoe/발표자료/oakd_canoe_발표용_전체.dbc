 SG_ C4 : 48|8@1+ (1,0) [0|255] "" CANOE

CM_ "OAK-D CAM01 classic CAN 500 kbps, Raw On messages (16 messages, 73 signals), depth and lane excluded";
CM_ BU_ CAM_PC "PC that reads the OAK-D over Ethernet and sends the results on CAN.";
CM_ BU_ CANOE "CANoe / CAN logger. Its trace time stamp is the single time axis.";
CM_ BO_ 768 "One per processed camera frame (every 200 ms at 5 fps). Seq links this frame to DET_BOX.SeqLo.";
CM_ SG_ 768 Seq "Camera frame sequence number modulo 65536.";
CM_ SG_ 768 EdgeMs "Latency inside the camera chip. 0 = no value.";
CM_ SG_ 768 SeqGap "Frames skipped since the previous message, saturates at 15.";
CM_ SG_ 768 ModelId "Model number, see value table.";
CM_ SG_ 768 RawOn "0=Raw Off (detection results only), 1=Raw On.";
CM_ BO_ 784 "One per detection, top N by confidence, Index 0 = highest. Box center and size normalized 0..1.";
CM_ SG_ 784 SeqLo "Low 4 bits of FRAME_STATUS.Seq.";
CM_ SG_ 784 Index "Box number within the frame (0 = highest confidence).";
CM_ SG_ 784 Label "Class number. a_yolom_n: car=1 (measured); person=0, tl_red=2, tl_green=3, tl_yellow=4 are assumed and must be confirmed.";
CM_ SG_ 784 Conf "Confidence 0..1 as reported by the camera, not an accuracy.";
CM_ BO_ 800 "Performance summary, once per second.";
CM_ SG_ 800 PostMs "Time to draw boxes on the raw image. 0 when Raw Off.";
CM_ SG_ 800 EthKBps "Bytes received from the camera over Ethernet per second (KB).";
CM_ SG_ 800 CanLoadPct "Estimated CAN bus load, worst case bit stuffing.";
CM_ SG_ 800 DroppedTotal "Total frames dropped by the camera input queue since start.";
CM_ BO_ 832 "Raw On. Per frame: exposure, ISO, color temperature.";
CM_ BO_ 833 "Raw On. Per frame: lens position (-1 = fixed focus), sensor size, camera socket, pixel format code.";
CM_ BO_ 834 "Raw On. Per frame: size of the image the network processed, field of view.";
CM_ BO_ 835 "Raw On. Per frame: capture time on the camera clock (us, wraps at 71.6 min) and capture-to-detection latency.";
CM_ BO_ 836 "Raw On. Per frame: capture time synced to the host clock (us, wraps) and capture-to-frame latency.";
CM_ BO_ 848 "Raw On. 1 Hz: chip temperatures and LEON CPU usage.";
CM_ BO_ 849 "Raw On. 1 Hz: DDR (MB) and CMX (KB) memory.";
CM_ BO_ 850 "Raw On. 1 Hz: LEON CSS heap (KB).";
CM_ BO_ 851 "Raw On. 1 Hz: LEON MSS heap (KB).";
CM_ BO_ 864 "Raw On. Every 10 s: RGB camera intrinsics in pixels of the network input size.";
CM_ BO_ 865 "Raw On. Every 10 s: class count and confidence threshold.";
CM_ BO_ 866 "Raw On. Every 10 s: network input size and connected camera sockets bit mask (bit0=CAM_A).";
CM_ BO_ 880 "Raw On. Every 10 s: text values in 5-character chunks (StrId 0=device id 1=product name 2=platform 3=bootloader 4=depthai version 5=model; chunk k holds chars 5k..5k+4).";
BA_DEF_ "BusType" STRING ;
BA_DEF_ BO_ "GenMsgCycleTime" INT 0 65535;
BA_DEF_DEF_ "BusType" "CAN";
BA_DEF_DEF_ "GenMsgCycleTime" 0;
BA_ "BusType" "CAN";
BA_ "GenMsgCycleTime" BO_ 800 1000;
VAL_ 768 RawOn 1 "Raw_On" 0 "Raw_Off" ;
VAL_ 768 ModelId 5 "a_yolom_n" 4 "traffic_light_v8n" 3 "traffic_light_11n" 2 "traffic_light" 1 "yolov8n" 0 "yolov6n" ;
VAL_ 880 StrId 5 "model" 4 "depthai_version" 3 "bootloader" 2 "platform" 1 "product_name" 0 "device_id" ;
